<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <!-- Portable TFM. The P/Invoke declarations in TiNative.cs and the engine in
         TiSpeechEngine.cs are Windows-only AT RUNTIME (they resolve TIBASE32.DLL,
         user32.dll and kernel32.dll), but they use no [SupportedOSPlatform]-annotated
         BCL API and no WinForms, so they compile clean under net10.0 on any host.
         This lets TiSpeech.Client and non-Windows hosts reference the enums and the
         engine contract without dragging in a Windows-only TFM. -->
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>TiSpeech</AssemblyName>
    <RootNamespace>TiSpeech</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <LangVersion>14</LangVersion>
  </PropertyGroup>

</Project>
